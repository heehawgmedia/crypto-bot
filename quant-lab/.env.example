# Copy to .env (gitignored). Keys are read from the environment ONLY —
# they never appear in YAML config or the database.
#
# When creating exchange API keys:
#   1. Grant TRADE permission only
#   2. DISABLE withdrawals
#   3. Enable the IP allowlist and restrict it to the machine running quant-lab
#
# Phase 1 (data layer) needs no keys at all: OHLCV endpoints are public.

QL_KRAKEN_API_KEY=
QL_KRAKEN_API_SECRET=

QL_COINBASE_API_KEY=
QL_COINBASE_API_SECRET=

# Optional Telegram alerts (fills + kill-switch events)
QL_TELEGRAM_BOT_TOKEN=
QL_TELEGRAM_CHAT_ID=
